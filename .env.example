# Copy to .env (local) or fill in Coolify's environment variables.
# All values below are OPTIONAL at boot — the site runs without them, but
# admin storage (Neon) and promotion emails (Resend) need their keys.

# ---------------------------------------------------------------- admin auth
# Credentials for /admin (change ADMIN_PASSWORD in production!).
ADMIN_ID=Admin
ADMIN_PASSWORD=KJ@2026
# Random long string used to sign session cookies.
# Falls back to sha256("kj-session:" + ADMIN_PASSWORD) when unset.
SESSION_SECRET=
# "true" forces Secure cookies (required behind HTTPS, e.g. Coolify).
# Defaults to true in production builds, false in dev.
COOKIE_SECURE=true

# ---------------------------------------------------------- Neon PostgreSQL
# Serverless Postgres connection string from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require

# ---------------------------------------------------------- Resend (email)
# API key from https://resend.com/api-keys — powers /admin/promotion.
RESEND_API_KEY=
# From-address. Unverified Resend domains can only send to your own address;
# verify a domain on Resend for customer-facing sending.
RESEND_FROM_EMAIL=Khan Jewellers <onboarding@resend.dev>

# ------------------------------------------------------------------ server
# PORT is set automatically by Coolify/Docker (default 3000).
# PORT=3000
# HOST=0.0.0.0
